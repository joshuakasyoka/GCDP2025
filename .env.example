# Optional — connect to MongoDB Atlas for persistent storage.
# Without this, data is stored in server/data/archive.json.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/gcdp-archive

# API server port (default 3001). Do not use PORT here — CRA reads PORT for its dev server (3000).
API_PORT=3001

# Protect CMS writes and uploads in production (recommended when live).
# Set the same value as REACT_APP_CMS_API_KEY in your frontend build.
CMS_API_KEY=your-secret-key-here

# Frontend — leave empty in dev (CRA proxy handles /api).
# In production, leave empty if app and API share the same origin.
REACT_APP_API_URL=

# Must match CMS_API_KEY when auth is enabled.
REACT_APP_CMS_API_KEY=your-secret-key-here

# When MONGODB_URI is set, uploaded images are stored in MongoDB GridFS
# and served at /api/media/{id}. Without Mongo, images save to public/uploads/.

# Mapbox public token for the archive map view (https://account.mapbox.com/access-tokens/)
REACT_APP_MAPBOX_TOKEN=your-mapbox-public-token
